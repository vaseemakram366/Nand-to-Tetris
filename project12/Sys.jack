class Sys {

    function void init() {
        do Memory.init();
        do Screen.init();
        do Output.init();
        do Keyboard.init();

        do Main.main();

        do Sys.halt();

        return;
    }

    function void halt() {
        while (true) {
        }

        return;
    }

    function void wait(int duration) {
        var int i;

        let i = 0;

        while (i < duration) {
            let i = i + 1;
        }

        return;
    }

    function void error(int errorCode) {
        do Output.printString("ERROR: ");
        do Output.printInt(errorCode);
        do Output.println();
        do Sys.halt();

        return;
    }
}