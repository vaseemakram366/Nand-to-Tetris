class Screen {

    static int screenBase;
    static int currentColor;

    function void init() {
        let screenBase = 16384;
        let currentColor = -1;
        do Screen.clearScreen();
        return;
    }

    function void clearScreen() {
        var int i;

        let i = 0;

        while (i < 8192) {
            do Memory.poke(screenBase + i, 0);
            let i = i + 1;
        }

        return;
    }

    function void setColor(boolean b) {
        if (b) {
            let currentColor = -1;
        } else {
            let currentColor = 0;
        }

        return;
    }

    function void drawPixel(int x, int y) {
        var int address;
        var int mask;

        let address = screenBase + (y * 32) + (x / 16);
        let mask = 1;

        let x = x - ((x / 16) * 16);

        while (x > 0) {
            let mask = mask * 2;
            let x = x - 1;
        }

        if (currentColor = 0) {
            do Memory.poke(
                address,
                Memory.peek(address) & (~mask)
            );
        } else {
            do Memory.poke(
                address,
                Memory.peek(address) | mask
            );
        }

        return;
    }

    function void drawLine(
        int x1,
        int y1,
        int x2,
        int y2
    ) {
        var int x, y;

        let x = x1;
        let y = y1;

        while (x <= x2) {
            do Screen.drawPixel(x, y);
            let x = x + 1;
        }

        return;
    }

    function void drawRectangle(
        int x1,
        int y1,
        int x2,
        int y2
    ) {
        var int x, y;

        let y = y1;

        while (y <= y2) {
            let x = x1;

            while (x <= x2) {
                do Screen.drawPixel(x, y);
                let x = x + 1;
            }

            let y = y + 1;
        }

        return;
    }

    function void drawCircle(
        int x,
        int y,
        int r
    ) {
        var int dx, dy;

        let dy = -r;

        while (dy <= r) {
            let dx = -r;

            while (dx <= r) {
                if ((dx * dx) + (dy * dy) <= (r * r)) {
                    do Screen.drawPixel(
                        x + dx,
                        y + dy
                    );
                }

                let dx = dx + 1;
            }

            let dy = dy + 1;
        }

        return;
    }
}