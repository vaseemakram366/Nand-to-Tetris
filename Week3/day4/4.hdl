// 4-Way MUX

```hdl
CHIP Mux4 {
    IN a, b, c, d, sel[2];
    OUT out;

    PARTS:
    // First stage: select between a and b
    Mux(a=a, b=b, sel=sel[0], out=ab);

    // First stage: select between c and d
    Mux(a=c, b=d, sel=sel[0], out=cd);

    // Second stage: select between the two results
    Mux(a=ab, b=cd, sel=sel[1], out=out);
}
```
