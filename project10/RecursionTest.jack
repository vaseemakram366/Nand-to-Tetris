class RecursionTest {
    function int factorial(int n) {
        if (n < 2) {
            return 1;
        }

        return n * RecursionTest.factorial(n - 1);
    }

    function void main() {
        var int result;

        let result = RecursionTest.factorial(5);

        do Output.printInt(result);
        do Output.println();

        return;
    }
}