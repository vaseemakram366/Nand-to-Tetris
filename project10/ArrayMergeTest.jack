class ArrayMergeTest {
    function void main() {
        var Array first;
        var Array second;
        var Array merged;
        var int i;
        var int j;
        var int k;

        let first = Array.new(4);
        let second = Array.new(3);
        let merged = Array.new(7);

        let first[0] = 10;
        let first[1] = 20;
        let first[2] = 30;
        let first[3] = 40;

        let second[0] = 15;
        let second[1] = 25;
        let second[2] = 35;

        let i = 0;
        let j = 0;
        let k = 0;

        while ((i < 4) & (j < 3)) {
            if (first[i] < second[j]) {
                let merged[k] = first[i];
                let i = i + 1;
            } else {
                let merged[k] = second[j];
                let j = j + 1;
            }
            let k = k + 1;
        }

        while (i < 4) {
            let merged[k] = first[i];
            let i = i + 1;
            let k = k + 1;
        }

        while (j < 3) {
            let merged[k] = second[j];
            let j = j + 1;
            let k = k + 1;
        }

        do Output.printString("Merged array: ");

        let i = 0;
        while (i < 7) {
            do Output.printInt(merged[i]);
            do Output.printString(" ");
            let i = i + 1;
        }

        do Output.println();

        do first.dispose();
        do second.dispose();
        do merged.dispose();

        return;
    }
}