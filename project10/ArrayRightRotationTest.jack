class ArrayRightRotationTest {
    function void main() {
        var Array numbers;
        var int i;
        var int last;
        var int n;

        let n = 6;
        let numbers = Array.new(n);

        let numbers[0] = 10;
        let numbers[1] = 20;
        let numbers[2] = 30;
        let numbers[3] = 40;
        let numbers[4] = 50;
        let numbers[5] = 60;

        let last = numbers[n - 1];
        let i = n - 1;

        while (i > 0) {
            let numbers[i] = numbers[i - 1];
            let i = i - 1;
        }

        let numbers[0] = last;

        do Output.printString("Right rotated array: ");

        let i = 0;
        while (i < n) {
            do Output.printInt(numbers[i]);
            do Output.printString(" ");
            let i = i + 1;
        }

        do Output.println();
        do numbers.dispose();

        return;
    }
}