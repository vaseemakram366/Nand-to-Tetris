class StarPatternTest {
    function void main() {
        var int i;
        var int j;

        let i = 1;

        while (i < 6) {
            let j = 0;

            while (j < i) {
                do Output.printString("* ");
                let j = j + 1;
            }

            do Output.println();
            let i = i + 1;
        }

        return;
    }
}