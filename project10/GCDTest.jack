class GCDTest {
    function int gcd(int a, int b) {
        var int remainder;

        while (b > 0) {
            let remainder = a - (a / b) * b;
            let a = b;
            let b = remainder;
        }

        return a;
    }

    function void main() {
        var int result;

        let result = GCDTest.gcd(48, 18);

        do Output.printString("GCD: ");
        do Output.printInt(result);
        do Output.println();

        return;
    }
}