class ArrayWavePatternTest {
    function void main() {
        var Array numbers;
        var int i;
        var int temp;
        var int n;

        let n = 6;
        let numbers = Array.new(n);

        let numbers[0] = 10;
        let numbers[1] = 5;
        let numbers[2] = 6;
        let numbers[3] = 3;
        let numbers[4] = 2;
        let numbers[5] = 20;

        let i = 0;

        while (i < n - 1) {
            if (numbers[i] < numbers[i + 1]) {
                let temp = numbers[i];
                let numbers[i] = numbers[i + 1];
                let numbers[i + 1] = temp;
            }

            let i = i + 1;

            if (i < n - 1) {
                if (numbers[i] > numbers[i + 1]) {
                    let temp = numbers[i];
                    let numbers[i] = numbers[i + 1];
                    let numbers[i + 1] = temp;
                }
            }

            let i = i + 1;
        }

        do Output.printString("Wave array: ");

        let i = 0;
        while (i < n) {
            do Output.printInt(numbers[i]);
            do Output.printString(" ");
            let i = i + 1;
        }

        do Output.println();
        do numbers.dispose();

        return;
    }
}