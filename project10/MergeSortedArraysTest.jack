class MergeSortedArraysTest {
    function void main() {
        var Array a;
        var Array b;
        var Array result;
        var int i, j, k;

        let a = Array.new(4);
        let b = Array.new(3);
        let result = Array.new(7);

        let a[0] = 2;
        let a[1] = 8;
        let a[2] = 15;
        let a[3] = 20;

        let b[0] = 5;
        let b[1] = 10;
        let b[2] = 18;

        let i = 0;
        let j = 0;
        let k = 0;

        while ((i < 4) & (j < 3)) {
            if (a[i] < b[j]) {
                let result[k] = a[i];
                let i = i + 1;
            } else {
                let result[k] = b[j];
                let j = j + 1;
            }

            let k = k + 1;
        }

        while (i < 4) {
            let result[k] = a[i];
            let i = i + 1;
            let k = k + 1;
        }

        while (j < 3) {
            let result[k] = b[j];
            let j = j + 1;
            let k = k + 1;
        }

        do Output.printString("Merged array: ");
        let i = 0;

        while (i < 7) {
            do Output.printInt(result[i]);
            do Output.printString(" ");
            let i = i + 1;
        }

        do Output.println();

        do a.dispose();
        do b.dispose();
        do result.dispose();

        return;
    }
}