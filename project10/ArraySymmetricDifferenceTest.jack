class ArraySymmetricDifferenceTest {
    function void main() {
        var Array first;
        var Array second;
        var int i;
        var int j;
        var int found;
        var int n;
        var int m;

        let n = 4;
        let m = 4;

        let first = Array.new(n);
        let second = Array.new(m);

        let first[0] = 10;
        let first[1] = 20;
        let first[2] = 30;
        let first[3] = 40;

        let second[0] = 30;
        let second[1] = 40;
        let second[2] = 50;
        let second[3] = 60;

        do Output.printString("Symmetric difference: ");

        let i = 0;
        while (i < n) {
            let found = 0;
            let j = 0;

            while ((j < m) & (found = 0)) {
                if (first[i] = second[j]) {
                    let found = 1;
                }
                let j = j + 1;
            }

            if (found = 0) {
                do Output.printInt(first[i]);
                do Output.printString(" ");
            }

            let i = i + 1;
        }

        let i = 0;
        while (i < m) {
            let found = 0;
            let j = 0;

            while ((j < n) & (found = 0)) {
                if (second[i] = first[j]) {
                    let found = 1;
                }
                let j = j + 1;
            }

            if (found = 0) {
                do Output.printInt(second[i]);
                do Output.printString(" ");
            }

            let i = i + 1;
        }

        do Output.println();

        do first.dispose();
        do second.dispose();

        return;
    }
}