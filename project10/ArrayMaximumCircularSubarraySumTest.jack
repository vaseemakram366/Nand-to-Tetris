class ArrayMaximumCircularSubarraySumTest {
    function void main() {
        var Array nums;
        var int n, i;
        var int total, currentMax, maxSum;
        var int currentMin, minSum, circularSum;
        var int answer;

        let n = 5;
        let nums = Array.new(n);

        let nums[0] = 5;
        let nums[1] = -3;
        let nums[2] = 5;
        let nums[3] = 2;
        let nums[4] = -1;

        let total = nums[0];
        let currentMax = nums[0];
        let maxSum = nums[0];
        let currentMin = nums[0];
        let minSum = nums[0];

        let i = 1;

        while (i < n) {
            let total = total + nums[i];

            let currentMax = currentMax + nums[i];
            if (nums[i] > currentMax) {
                let currentMax = nums[i];
            }

            if (currentMax > maxSum) {
                let maxSum = currentMax;
            }

            let currentMin = currentMin + nums[i];
            if (nums[i] < currentMin) {
                let currentMin = nums[i];
            }

            if (currentMin < minSum) {
                let minSum = currentMin;
            }

            let i = i + 1;
        }

        if (maxSum < 0) {
            let answer = maxSum;
        }
        else {
            let circularSum = total - minSum;

            if (circularSum > maxSum) {
                let answer = circularSum;
            }
            else {
                let answer = maxSum;
            }
        }

        do Output.printString("Maximum Circular Subarray Sum: ");
        do Output.printInt(answer);
        do Output.println();

        do nums.dispose();

        return;
    }
}   