class ArrayExpressionTest {
    function void main() {
        var Array arr;
        var int i;
        var int result;

        let arr = Array.new(5);
        let i = 0;

        while (i < 5) {
            let arr[i] = i * i;
            let i = i + 1;
        }

        let result = arr[2] + arr[3];

        do Output.printInt(result);
        do Output.println();

        do arr.dispose();

        return;
    }
}