class ArraySubarraySumTest {
    function void main() {
        var Array numbers;
        var int i;
        var int currentSum;
        var int maxSum;
        var int n;

        let n = 8;
        let numbers = Array.new(n);

        let numbers[0] = -2;
        let numbers[1] = 1;
        let numbers[2] = -3;
        let numbers[3] = 4;
        let numbers[4] = -1;
        let numbers[5] = 2;
        let numbers[6] = 1;
        let numbers[7] = -5;

        let currentSum = numbers[0];
        let maxSum = numbers[0];
        let i = 1;

        while (i < n) {
            if (currentSum > 0) {
                let currentSum = currentSum + numbers[i];
            } else {
                let currentSum = numbers[i];
            }

            if (currentSum > maxSum) {
                let maxSum = currentSum;
            }

            let i = i + 1;
        }

        do Output.printString("Maximum subarray sum: ");
        do Output.printInt(maxSum);
        do Output.println();

        do numbers.dispose();
        return;
    }
}