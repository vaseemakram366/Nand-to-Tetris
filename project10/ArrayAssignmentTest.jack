class ArrayAssignmentTest {
    function void main() {
        var Array arr;
        var int i;
        var int value;

        let arr = Array.new(5);
        let i = 0;

        while (i < 5) {
            let arr[i] = (i + 1) * 10;
            let i = i + 1;
        }

        let value = arr[3];

        do Output.printInt(value);
        do Output.println();

        do arr.dispose();

        return;
    }
}