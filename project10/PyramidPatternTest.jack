class PyramidPatternTest {
    function void main() {
        var int i;
        var int j;
        var int spaces;

        let i = 1;

        while (i < 6) {
            let spaces = 5 - i;

            while (spaces > 0) {
                do Output.printString(" ");
                let spaces = spaces - 1;
            }

            let j = 0;

            while (j < i) {
                do Output.printString("* ");
                let j = j + 1;
            }

            do Output.println();
            let i = i + 1;
        }

        return;
    }
}