class ArrayMinimumJumpsTest {
    function void main() {
        var Array nums, dp;
        var int n, i, j, jumps, answer;

        let n = 5;
        let nums = Array.new(n);
        let dp = Array.new(n);

        let nums[0] = 2;
        let nums[1] = 3;
        let nums[2] = 1;
        let nums[3] = 1;
        let nums[4] = 4;

        let i = 0;
        while (i < n) {
            let dp[i] = 10000;
            let i = i + 1;
        }

        let dp[0] = 0;
        let i = 0;

        while (i < n) {
            let j = i + 1;

            while (j < n) {
                if (j < i + nums[i] + 1) {
                    let jumps = dp[i] + 1;

                    if (jumps < dp[j]) {
                        let dp[j] = jumps;
                    }
                }

                let j = j + 1;
            }

            let i = i + 1;
        }

        let answer = dp[n - 1];

        do Output.printString("Minimum Jumps: ");
        do Output.printInt(answer);
        do Output.println();

        do nums.dispose();
        do dp.dispose();

        return;
    }
}