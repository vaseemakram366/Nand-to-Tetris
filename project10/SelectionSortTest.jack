class SelectionSortTest {
    function void main() {
        var Array numbers;
        var int i, j, minIndex, temp, n;

        let n = 5;
        let numbers = Array.new(n);

        let numbers[0] = 64;
        let numbers[1] = 25;
        let numbers[2] = 12;
        let numbers[3] = 22;
        let numbers[4] = 11;

        let i = 0;

        while (i < n - 1) {
            let minIndex = i;
            let j = i + 1;

            while (j < n) {
                if (numbers[j] < numbers[minIndex]) {
                    let minIndex = j;
                }
                let j = j + 1;
            }

            let temp = numbers[i];
            let numbers[i] = numbers[minIndex];
            let numbers[minIndex] = temp;

            let i = i + 1;
        }

        do Output.printString("Sorted: ");
        let i = 0;

        while (i < n) {
            do Output.printInt(numbers[i]);
            do Output.printString(" ");
            let i = i + 1;
        }

        do Output.println();
        do numbers.dispose();
        return;
    }
}