class ArrayEquilibriumIndexTest {
    function void main() {
        var Array numbers;
        var int i;
        var int j;
        var int leftSum;
        var int rightSum;
        var int equilibrium;
        var int n;

        let n = 5;
        let numbers = Array.new(n);

        let numbers[0] = 1;
        let numbers[1] = 3;
        let numbers[2] = 5;
        let numbers[3] = 2;
        let numbers[4] = 2;

        let equilibrium = -1;
        let i = 0;

        while ((i < n) & (equilibrium = -1)) {
            let leftSum = 0;
            let rightSum = 0;
            let j = 0;

            while (j < i) {
                let leftSum = leftSum + numbers[j];
                let j = j + 1;
            }

            let j = i + 1;

            while (j < n) {
                let rightSum = rightSum + numbers[j];
                let j = j + 1;
            }

            if (leftSum = rightSum) {
                let equilibrium = i;
            }

            let i = i + 1;
        }

        if (equilibrium > -1) {
            do Output.printString("Equilibrium index: ");
            do Output.printInt(equilibrium);
        } else {
            do Output.printString("No equilibrium index found");
        }

        do Output.println();
        do numbers.dispose();

        return;
    }
}