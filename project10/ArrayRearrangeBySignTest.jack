class ArrayRearrangeBySignTest {
    function void main() {
        var Array nums, result;
        var int n, i, pos, neg;

        let n = 6;
        let nums = Array.new(n);
        let result = Array.new(n);

        let nums[0] = 3;
        let nums[1] = 1;
        let nums[2] = -2;
        let nums[3] = -5;
        let nums[4] = 2;
        let nums[5] = -4;

        let pos = 0;
        let neg = 1;
        let i = 0;

        while (i < n) {
            if (nums[i] > 0) {
                let result[pos] = nums[i];
                let pos = pos + 2;
            }
            else {
                let result[neg] = nums[i];
                let neg = neg + 2;
            }

            let i = i + 1;
        }

        do Output.printString("Rearranged Array: ");

        let i = 0;
        while (i < n) {
            do Output.printInt(result[i]);
            do Output.printString(" ");
            let i = i + 1;
        }

        do Output.println();

        do nums.dispose();
        do result.dispose();

        return;
    }
}