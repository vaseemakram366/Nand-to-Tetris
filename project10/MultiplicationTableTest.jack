class MultiplicationTableTest {
    function void main() {
        var int number;
        var int i;
        var int result;

        let number = 7;
        let i = 1;

        while (i < 11) {
            let result = number * i;

            do Output.printInt(number);
            do Output.printString(" x ");
            do Output.printInt(i);
            do Output.printString(" = ");
            do Output.printInt(result);
            do Output.println();

            let i = i + 1;
        }

        return;
    }
}