class ReturnExpressionTest {
    function int calculate(int a, int b) {
        return (a + b) * (a - b);
    }

    function int getValue() {
        return 100 + 25;
    }

    function void main() {
        var int result;

        let result = ReturnExpressionTest.calculate(10, 4);
        do Output.printInt(result);
        do Output.println();

        let result = ReturnExpressionTest.getValue();
        do Output.printInt(result);
        do Output.println();

        return;
    }
}