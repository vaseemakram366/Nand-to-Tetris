class ArrayMinimumSubarraySumTest {
    function void main() {
        var Array numbers;
        var int i;
        var int currentSum;
        var int minSum;
        var int n;

        let n = 8;
        let numbers = Array.new(n);

        let numbers[0] = 3;
        let numbers[1] = -4;
        let numbers[2] = 2;
        let numbers[3] = -3;
        let numbers[4] = -1;
        let numbers[5] = 7;
        let numbers[6] = -5;
        let numbers[7] = 2;

        let currentSum = numbers[0];
        let minSum = numbers[0];
        let i = 1;

        while (i < n) {
            if (currentSum < 0) {
                let currentSum = currentSum + numbers[i];
            } else {
                let currentSum = numbers[i];
            }

            if (currentSum < minSum) {
                let minSum = currentSum;
            }

            let i = i + 1;
        }

        do Output.printString("Minimum subarray sum: ");
        do Output.printInt(minSum);
        do Output.println();

        do numbers.dispose();
        return;
    }
}