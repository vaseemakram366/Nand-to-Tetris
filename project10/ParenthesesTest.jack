class ParenthesesTest {
    function void main() {
        var int a;
        var int b;
        var int result;

        let a = 10;
        let b = 5;

        let result = (a + b) * (a - b);

        do Output.printInt(result);
        do Output.println();

        let result = a * (b + 2);

        do Output.printInt(result);
        do Output.println();

        return;
    }
}