class ArrayMajorityElementTest {
    function void main() {
        var Array numbers;
        var int i;
        var int j;
        var int count;
        var int majority;
        var int found;

        let numbers = Array.new(7);

        let numbers[0] = 3;
        let numbers[1] = 3;
        let numbers[2] = 4;
        let numbers[3] = 3;
        let numbers[4] = 5;
        let numbers[5] = 3;
        let numbers[6] = 3;

        let majority = 0;
        let found = 0;
        let i = 0;

        while ((i < 7) & (found = 0)) {
            let count = 0;
            let j = 0;

            while (j < 7) {
                if (numbers[i] = numbers[j]) {
                    let count = count + 1;
                }
                let j = j + 1;
            }

            if (count > 3) {
                let majority = numbers[i];
                let found = 1;
            }

            let i = i + 1;
        }

        if (found = 1) {
            do Output.printString("Majority element: ");
            do Output.printInt(majority);
        } else {
            do Output.printString("No majority element");
        }

        do Output.println();
        do numbers.dispose();

        return;
    }
}