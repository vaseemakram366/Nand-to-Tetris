class FibonacciTest {
    function void main() {
        var int a, b, temp, i, n;

        let a = 0;
        let b = 1;
        let i = 0;
        let n = 10;

        do Output.printString("Fibonacci: ");

        while (i < n) {
            do Output.printInt(a);
            do Output.printString(" ");

            let temp = a + b;
            let a = b;
            let b = temp;
            let i = i + 1;
        }

        do Output.println();
        return;
    }
}