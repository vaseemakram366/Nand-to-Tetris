class FactorialTest {
    function int factorial(int n) {
        var int result;

        let result = 1;

        while (n > 1) {
            let result = result * n;
            let n = n - 1;
        }

        return result;
    }

    function void main() {
        var int number;
        var int result;

        let number = 5;
        let result = FactorialTest.factorial(number);

        do Output.printString("Factorial: ");
        do Output.printInt(result);
        do Output.println();

        return;
    }
}