class ArrayEditDistanceTest {
    function void main() {
        var Array a, b, dp;
        var int m, n, i, j;
        var int index, cost, answer;
        var int insertCost, deleteCost, replaceCost;

        let m = 6;
        let n = 7;

        let a = Array.new(m);
        let b = Array.new(n);
        let dp = Array.new((m + 1) * (n + 1));

        // String: kitten
        let a[0] = 107;
        let a[1] = 105;
        let a[2] = 116;
        let a[3] = 116;
        let a[4] = 101;
        let a[5] = 110;

        // String: sitting
        let b[0] = 115;
        let b[1] = 105;
        let b[2] = 116;
        let b[3] = 116;
        let b[4] = 105;
        let b[5] = 110;
        let b[6] = 103;

        let i = 0;
        while (i < m + 1) {
            let dp[i * (n + 1)] = i;
            let i = i + 1;
        }

        let j = 0;
        while (j < n + 1) {
            let dp[j] = j;
            let j = j + 1;
        }

        let i = 1;
        while (i < m + 1) {
            let j = 1;

            while (j < n + 1) {
                let index = i * (n + 1) + j;
                let cost = 1;

                if (a[i - 1] = b[j - 1]) {
                    let cost = 0;
                }

                let insertCost = dp[i * (n + 1) + j - 1] + 1;
                let deleteCost = dp[(i - 1) * (n + 1) + j] + 1;
                let replaceCost = dp[(i - 1) * (n + 1) + j - 1] + cost;

                let dp[index] = insertCost;

                if (deleteCost < dp[index]) {
                    let dp[index] = deleteCost;
                }

                if (replaceCost < dp[index]) {
                    let dp[index] = replaceCost;
                }

                let j = j + 1;
            }

            let i = i + 1;
        }

        let answer = dp[m * (n + 1) + n];

        do Output.printString("Minimum Edit Distance: ");
        do Output.printInt(answer);
        do Output.println();

        do a.dispose();
        do b.dispose();
        do dp.dispose();

        return;
    }
}