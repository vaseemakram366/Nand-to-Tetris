class CountPositiveNegativeTest {
    function void main() {
        var Array numbers;
        var int i;
        var int positive;
        var int negative;
        var int zero;

        let numbers = Array.new(8);

        let numbers[0] = 12;
        let numbers[1] = -5;
        let numbers[2] = 0;
        let numbers[3] = 23;
        let numbers[4] = -8;
        let numbers[5] = 0;
        let numbers[6] = 17;
        let numbers[7] = -3;

        let positive = 0;
        let negative = 0;
        let zero = 0;
        let i = 0;

        while (i < 8) {
            if (numbers[i] > 0) {
                let positive = positive + 1;
            } else {
                if (numbers[i] < 0) {
                    let negative = negative + 1;
                } else {
                    let zero = zero + 1;
                }
            }

            let i = i + 1;
        }

        do Output.printString("Positive numbers: ");
        do Output.printInt(positive);
        do Output.println();

        do Output.printString("Negative numbers: ");
        do Output.printInt(negative);
        do Output.println();

        do Output.printString("Zeros: ");
        do Output.printInt(zero);
        do Output.println();

        do numbers.dispose();
        return;
    }
}