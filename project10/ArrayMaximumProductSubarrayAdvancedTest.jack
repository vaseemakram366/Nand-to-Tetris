class ArrayMaximumProductSubarrayTest {
    function void main() {
        var Array nums;
        var int n, i;
        var int maxProduct, minProduct;
        var int previousMax, temp;
        var int answer;

        let n = 5;
        let nums = Array.new(n);

        let nums[0] = 2;
        let nums[1] = 3;
        let nums[2] = -2;
        let nums[3] = 4;
        let nums[4] = -1;

        let maxProduct = nums[0];
        let minProduct = nums[0];
        let answer = nums[0];

        let i = 1;

        while (i < n) {
            let previousMax = maxProduct;

            let maxProduct = maxProduct * nums[i];
            let minProduct = minProduct * nums[i];

            if (maxProduct < minProduct) {
                let temp = maxProduct;
                let maxProduct = minProduct;
                let minProduct = temp;
            }

            if (nums[i] > maxProduct) {
                let maxProduct = nums[i];
            }

            if (nums[i] < minProduct) {
                let minProduct = nums[i];
            }

            if (maxProduct > answer) {
                let answer = maxProduct;
            }

            let i = i + 1;
        }

        do Output.printString("Maximum Product Subarray: ");
        do Output.printInt(answer);
        do Output.println();

        do nums.dispose();

        return;
    }
}