class MoveZerosTest {
    function void main() {
        var Array numbers;
        var int n, i, j, temp;

        let n = 7;
        let numbers = Array.new(n);

        let numbers[0] = 0;
        let numbers[1] = 1;
        let numbers[2] = 0;
        let numbers[3] = 3;
        let numbers[4] = 12;
        let numbers[5] = 0;
        let numbers[6] = 5;

        let i = 0;
        let j = 0;

        while (i < n) {
            if (numbers[i] != 0) {
                let temp = numbers[i];
                let numbers[i] = numbers[j];
                let numbers[j] = temp;
                let j = j + 1;
            }

            let i = i + 1;
        }

        do Output.printString("After moving zeros: ");
        let i = 0;

        while (i < n) {
            do Output.printInt(numbers[i]);
            do Output.printString(" ");
            let i = i + 1;
        }

        do Output.println();
        do numbers.dispose();

        return;
    }
}