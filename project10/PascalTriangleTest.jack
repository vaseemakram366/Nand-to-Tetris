class PascalTriangleTest {
    function void main() {
        var int row;
        var int col;
        var int value;
        var int spaces;

        let row = 0;

        while (row < 6) {
            let spaces = 5 - row;

            while (spaces > 0) {
                do Output.printString(" ");
                let spaces = spaces - 1;
            }

            let col = 0;
            let value = 1;

            while (col < (row + 1)) {
                do Output.printInt(value);
                do Output.printString(" ");

                let value = value * (row - col);
                let value = value / (col + 1);

                let col = col + 1;
            }

            do Output.println();
            let row = row + 1;
        }

        return;
    }
}