class ArrayLongestCommonSubsequenceTest {
    function void main() {
        var Array a, b, dp;
        var int m, n, i, j, index;
        var int answer;

        let m = 6;
        let n = 5;

        let a = Array.new(m);
        let b = Array.new(n);
        let dp = Array.new((m + 1) * (n + 1));

        let a[0] = 1;
        let a[1] = 3;
        let a[2] = 4;
        let a[3] = 1;
        let a[4] = 2;
        let a[5] = 3;

        let b[0] = 3;
        let b[1] = 4;
        let b[2] = 1;
        let b[3] = 2;
        let b[4] = 1;

        let i = 0;
        while (i < (m + 1) * (n + 1)) {
            let dp[i] = 0;
            let i = i + 1;
        }

        let i = 1;
        while (i < m + 1) {
            let j = 1;

            while (j < n + 1) {
                let index = i * (n + 1) + j;

                if (a[i - 1] = b[j - 1]) {
                    let dp[index] = dp[(i - 1) * (n + 1) + j - 1] + 1;
                }
                else {
                    let dp[index] = dp[(i - 1) * (n + 1) + j];

                    if (dp[i * (n + 1) + j - 1] > dp[index]) {
                        let dp[index] = dp[i * (n + 1) + j - 1];
                    }
                }

                let j = j + 1;
            }

            let i = i + 1;
        }

        let answer = dp[m * (n + 1) + n];

        do Output.printString("Longest Common Subsequence Length: ");
        do Output.printInt(answer);
        do Output.println();

        do a.dispose();
        do b.dispose();
        do dp.dispose();

        return;
    }
}