class IntegerConstantTest {
    function void main() {
        var int a;
        var int b;
        var int result;

        let a = 123;
        let b = 456;

        let result = a + b;

        do Output.printInt(result);
        do Output.println();

        let result = 32767;

        do Output.printInt(result);
        do Output.println();

        return;
    }
}