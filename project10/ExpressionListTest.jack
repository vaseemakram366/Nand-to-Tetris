class ExpressionListTest {
    function int calculate(int a, int b, int c) {
        return a + b + c;
    }

    function void main() {
        var int result;

        let result = ExpressionListTest.calculate(
            10 + 5,
            20 * 2,
            30 - 10
        );

        do Output.printInt(result);
        do Output.println();

        return;
    }
}