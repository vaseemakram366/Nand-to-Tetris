class LargestNumberTest {
    function void main() {
        var int a;
        var int b;
        var int c;
        var int largest;

        let a = 45;
        let b = 78;
        let c = 32;

        let largest = a;

        if (b > largest) {
            let largest = b;
        }

        if (c > largest) {
            let largest = c;
        }

        do Output.printString("Largest: ");
        do Output.printInt(largest);
        do Output.println();

        return;
    }
}